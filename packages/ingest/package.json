{
  "name": "@tela/ingest",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Ingestion library: HTTP client, feed discovery, feed fetching, article extraction (no queue, no runtime-specific APIs)",
  "exports": {
    ".": "./src/index.ts",
    "./http": "./src/http.ts",
    "./net": "./src/net.ts",
    "./pipeline": "./src/pipeline/index.ts",
    "./relay": "./src/relay.ts",
    "./schedule": "./src/schedule.ts",
    "./region-policy": "./src/region-policy.ts",
    "./websub": "./src/websub.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@tela/content": "workspace:*",
    "@tela/data": "workspace:*",
    "@tela/platform": "workspace:*",
    "@tela/shared": "workspace:*",
    "domutils": "^3.2.2",
    "drizzle-orm": "^0.45.2",
    "htmlparser2": "^10.1.0"
  }
}
