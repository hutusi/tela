{
  "name": "@tela/data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Tela's SQLite data model for D1 and libSQL: schema, migrations, leases, the sync sequence, and query helpers",
  "exports": {
    ".": "./src/index.ts",
    "./schema": "./src/schema/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "typecheck": "tsc -p tsconfig.json && tsc -p test/workers/tsconfig.json",
    "test:workers": "vitest run --config test/workers/vitest.config.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260927.1",
    "@vitest/runner": "^4.1.0",
    "@vitest/snapshot": "^4.1.0",
    "drizzle-kit": "^0.31.10",
    "vitest": "^4.1.0"
  },
  "dependencies": {
    "@tela/platform": "workspace:*",
    "@tela/shared": "workspace:*",
    "drizzle-orm": "^0.45.2"
  }
}
