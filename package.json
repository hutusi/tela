{
  "name": "tela",
  "version": "0.0.0",
  "private": true,
  "description": "Tela: a multilingual reader and gathering place for independent blogs",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "bun run --filter @tela/reader dev",
    "build": "bun run --filter '@tela/*' build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "bun run --filter '@tela/*' typecheck",
    "test": "bun test --timeout 120000",
    "test:workers": "bun run --filter '@tela/*' test:workers",
    "e2e": "apps/reader/e2e/run.sh",
    "db:generate": "bun run --filter @tela/data generate",
    "admin": "bun apps/api/scripts/admin.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "^24",
    "typescript": "^7.0.2",
    "@types/bun": "^1.4.1"
  },
  "trustedDependencies": [
    "unrs-resolver"
  ]
}
