{
  "name": "tela",
  "version": "0.0.0",
  "private": true,
  "description": "Tela: a multilingual reader and gathering place for independent blogs",
  "packageManager": "bun@1.3.14",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "bun run --filter @tela/web dev",
    "dev:worker": "bun run --filter @tela/worker dev",
    "build": "bun run --filter '@tela/*' build",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "bun run --filter '@tela/*' typecheck",
    "test": "bun test --timeout 120000",
    "db:generate": "bun run --filter @tela/db generate",
    "db:migrate": "bun run --filter @tela/db migrate",
    "db:local": "bun run --filter @tela/db local-db",
    "worker:once": "bun run --filter @tela/worker once"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@types/node": "^26",
    "typescript": "^5.9",
    "@types/bun": "^1.3.14"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
