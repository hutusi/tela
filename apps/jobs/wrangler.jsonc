{
  // tela-jobs (ADR 0020): cron sweeps and queue consumers, every job run by this Worker's own
  // fetch handler, which placement pins beside the D1 primary in Singapore. No public route.
  "name": "tela-jobs",
  "main": "src/worker.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": false,
  "placement": { "region": "aws:ap-southeast-1" },
  // A whole-feed pass measured ≤ 513 ms and an extraction ≤ 397 ms (spike S2); a minute is room.
  "limits": { "cpu_ms": 60000 },
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tela",
      // `wrangler d1 create tela --location apac`: the primary is in Singapore.
      "database_id": "b78974b8-403a-460d-a15d-acaaaf119952",
      "migrations_dir": "../../packages/data/migrations"
    }
  ],
  "r2_buckets": [
    // Members-only content objects (served through tela-web's /o/*).
    { "binding": "BLOBS", "bucket_name": "tela-content" },
    // Public favicons, served at assets.telaread.com (and still at assets.tela.ainaive.com).
    { "binding": "ASSETS", "bucket_name": "tela-assets" }
  ],
  "services": [{ "binding": "SELF", "service": "tela-jobs" }],
  "queues": {
    "producers": [
      { "binding": "FETCH_QUEUE", "queue": "tela-fetch" },
      { "binding": "EXTRACT_QUEUE", "queue": "tela-extract" },
      { "binding": "TRANSLATE_QUEUE", "queue": "tela-translate" },
      { "binding": "MISC_QUEUE", "queue": "tela-misc" }
    ],
    // Consumers always ack; retries come from lease state. The DLQ is only an alarm.
    "consumers": [
      {
        "queue": "tela-fetch",
        "max_batch_size": 5,
        "max_concurrency": 10,
        "max_retries": 2,
        "dead_letter_queue": "tela-dlq"
      },
      {
        "queue": "tela-extract",
        "max_batch_size": 3,
        "max_concurrency": 5,
        "max_retries": 2,
        "dead_letter_queue": "tela-dlq"
      },
      {
        "queue": "tela-translate",
        "max_batch_size": 1,
        "max_concurrency": 4,
        "max_retries": 2,
        "dead_letter_queue": "tela-dlq"
      },
      {
        "queue": "tela-misc",
        "max_batch_size": 5,
        "max_concurrency": 4,
        "max_retries": 2,
        "dead_letter_queue": "tela-dlq"
      }
    ]
  },
  // Every minute: the sweeps. Nightly: upkeep and the backup. Monday 08:00 UTC: the digest.
  "triggers": { "crons": ["* * * * *", "17 3 * * *", "0 8 * * 1"] },
  "vars": {
    "WORKER_USER_AGENT": "Tela/0.1 (+https://telaread.com; feed reader)",
    "FETCH_TIMEOUT_MS": "20000",
    "WEBSUB_ENABLED": "0",
    "PUBLIC_URL": "https://telaread.com",
    "MAIL_FROM": "Tela <noreply@ainaive.com>",
    // The day's ceiling on background title translation, kept in the config so every deploy
    // carries it: until 2026-10-04 it was set nowhere, and titles ran uncapped. A new reading
    // language's whole-archive backfill cost about 320k tokens in October 2026.
    "LLM_DAILY_BUDGET_TOKENS": "2000000"
  },
  // Secrets (wrangler secret put): BAILIAN_API_KEY, RESEND_API_KEY, DIGEST_TO, DEADMAN_URL.
  "env": {
    // Gate G2 (throwaway): the same Worker against the 40 production feeds beside the Fly
    // worker, on its own database, bucket and queues. No ASSETS binding, so favicons are off and
    // the public bucket stays untouched. Deploy with `wrangler deploy --env shadow`; delete after.
    "shadow": {
      "name": "tela-jobs-shadow",
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "tela-shadow",
          "database_id": "0f6f0869-b132-4369-8a9e-1490611c438b",
          "migrations_dir": "../../packages/data/migrations"
        }
      ],
      "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "tela-content-shadow" }],
      "services": [{ "binding": "SELF", "service": "tela-jobs-shadow" }],
      "queues": {
        "producers": [
          { "binding": "FETCH_QUEUE", "queue": "tela-shadow-fetch" },
          { "binding": "EXTRACT_QUEUE", "queue": "tela-shadow-extract" },
          { "binding": "TRANSLATE_QUEUE", "queue": "tela-shadow-translate" },
          { "binding": "MISC_QUEUE", "queue": "tela-shadow-misc" }
        ],
        "consumers": [
          {
            "queue": "tela-shadow-fetch",
            "max_batch_size": 5,
            "max_concurrency": 10,
            "max_retries": 2,
            "dead_letter_queue": "tela-shadow-dlq"
          },
          {
            "queue": "tela-shadow-extract",
            "max_batch_size": 3,
            "max_concurrency": 5,
            "max_retries": 2,
            "dead_letter_queue": "tela-shadow-dlq"
          },
          {
            "queue": "tela-shadow-translate",
            "max_batch_size": 1,
            "max_concurrency": 4,
            "max_retries": 2,
            "dead_letter_queue": "tela-shadow-dlq"
          },
          {
            "queue": "tela-shadow-misc",
            "max_batch_size": 5,
            "max_concurrency": 4,
            "max_retries": 2,
            "dead_letter_queue": "tela-shadow-dlq"
          }
        ]
      },
      "triggers": { "crons": ["* * * * *", "17 3 * * *"] },
      "vars": {
        "WORKER_USER_AGENT": "Tela/0.1 (+https://telaread.com; feed reader)",
        "FETCH_TIMEOUT_MS": "20000",
        "WEBSUB_ENABLED": "0",
        "PUBLIC_URL": "https://telaread.com"
      }
    }
  }
}
