# Local development (next dev). On Cloudflare the HYPERDRIVE binding replaces DATABASE_URL.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Local-only: sign every request in as the development user (refused on Cloudflare).
TELA_DEV_AUTH=1
# HMAC secret for /img proxy URLs (any long random string). Required in production.
IMAGE_PROXY_SECRET=
