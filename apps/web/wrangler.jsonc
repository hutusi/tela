{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tela-web",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // The custom domain is created (DNS record and certificate) by the deploy; the zone lives in
  // the same account. A route without `workers_dev` turns the workers.dev address off, which is
  // wanted: the custom domain is the only public origin (workers.dev is blocked in mainland China).
  "routes": [{ "pattern": "tela.ainaive.com", "custom_domain": true }],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "tela-web"
    }
  ],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // From `wrangler hyperdrive create tela-db` (see docs/OPERATIONS.md); ids are not secrets.
      "id": "7a4fb1ce1f62406db8e7bef95e10f3bd",
      "localConnectionString": "postgresql://postgres:postgres@127.0.0.1:54322/postgres"
    }
  ],
  "placement": { "mode": "smart" },
  "observability": { "enabled": true }
}
