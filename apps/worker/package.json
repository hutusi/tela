{
  "name": "@tela/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Tela background worker: one codebase, roles selected by WORKER_ROLES",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --target=node --outdir dist --sourcemap=external --external sharp --external pg-native",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json",
    "once": "bun run src/cli.ts"
  },
  "dependencies": {
    "@tela/content": "workspace:*",
    "@tela/db": "workspace:*",
    "@tela/ingest": "workspace:*",
    "@tela/llm": "workspace:*",
    "@tela/shared": "workspace:*",
    "drizzle-orm": "^0.45.2",
    "entities": "^7.0.0",
    "pg-boss": "^12.30.0",
    "postgres": "^3.4.9",
    "zod": "^4.5.4"
  }
}
