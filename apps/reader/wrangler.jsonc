{
  // tela-web (ADR 0020, 0024): the one public Worker, at the reader's edge, unpinned. The first
  // deploy replaces the Next.js app that holds the name today: that is the cutover
  // (docs/OPERATIONS.md). Built with `vite build`, which bundles the SPA and this Worker together.
  "name": "tela-web",
  "main": "worker/index.ts",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // The custom domain is the only public origin: workers.dev is blocked in mainland China. The old
  // address and www are tela-redirect's (`redirect/`, ADR 0042): never list them here, since a
  // deploy takes every domain it lists from whichever Worker holds it.
  "workers_dev": false,
  "routes": [{ "pattern": "telaread.com", "custom_domain": true }],
  // Paths are logged, query strings never: `/join?code=…` and a sign-in link's `?email=…&otp=…`
  // would put a code where anyone who reads Workers Logs could use it.
  "observability": { "enabled": true, "redact_query_string": true },
  // The SPA's static assets answer every other path for free, without running the Worker; a
  // path with no asset is the app itself. The Worker runs first only where it has work to do:
  // "/" is the front page it renders for visitors (ADR 0035), and exactly "/", never "/*";
  // Discover's tabs are listed one by one for the same reason, never "/discover/*" (ADR 0044,
  // and Blogrolls, ADR 0050). "/l/*" is a blogroll's page (ADR 0050), and its feeds,
  // `/l/<id>.rss` and `/l/<id>.opml`; Discover's two feeds are listed by name (ADR 0062). Each
  // sitemap is named on its own, at the root where a sitemap must sit to list the whole site,
  // and so is llms.txt (ADR 0060).
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/",
      "/api/*",
      "/o/*",
      "/img/*",
      "/avatar/*",
      "/robots.txt",
      "/sitemap.xml",
      "/sitemap-pages.xml",
      "/sitemap-sites.xml",
      "/sitemap-blogrolls.xml",
      "/sitemap-profiles.xml",
      "/llms.txt",
      "/discover",
      "/discover/articles",
      "/discover/blogs",
      "/discover/blogrolls",
      "/discover/readers",
      "/discover.opml",
      "/discover/articles.rss",
      "/s/*",
      "/l/*",
      "/@*",
      "/about",
      "/privacy",
      "/terms"
    ]
  },
  "r2_buckets": [{ "binding": "BLOBS", "bucket_name": "tela-content" }],
  "services": [{ "binding": "API", "service": "tela-api" }],
  // Nothing is indexed while TELA_NOINDEX is set (ADR 0060): launch day deploys without it.
  "vars": { "TELA_NOINDEX": "1" }
  // Secrets (wrangler secret put): AUTH_SECRET, the same value as tela-api's.
}
